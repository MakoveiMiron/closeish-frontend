# For static hosts supporting a Netlify/Cloudflare Pages-style _headers file.
# Set equivalent response headers at the CDN if your host does not read this file.
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/config.js
  Cache-Control: no-cache, max-age=0, must-revalidate
/api/*
  Cache-Control: no-store
/*
  X-Content-Type-Options: nosniff

# Versioned static assets may be cached; index/config are always revalidated.
/startup-guard.js
  Cache-Control: public, max-age=604800
/api.js
  Cache-Control: public, max-age=604800
/view-core.js
  Cache-Control: public, max-age=604800
/community.js
  Cache-Control: public, max-age=604800
/score-chart.js
  Cache-Control: public, max-age=604800
/statistics-client.js
  Cache-Control: public, max-age=604800
/game.js
  Cache-Control: public, max-age=604800
/mobile-viewport.js
  Cache-Control: public, max-age=604800
/style.css
  Cache-Control: public, max-age=604800

/404.html
  Cache-Control: no-cache, max-age=0
/500.html
  Cache-Control: no-cache, max-age=0
